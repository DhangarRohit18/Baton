# BATON Production Configuration Environment Variables

# --- Core Security ---
SECRET_KEY=change-this-to-a-very-secure-32-byte-hex-string-for-jwt-signing
QR_BRIDGE_SIGNING_SALT=change-this-to-a-high-entropy-crypto-salt-for-hmac-qr-tokens
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database & Cache ---
# For PostgreSQL with pgvector (production):
DATABASE_URL=postgresql://baton_user:baton_secure_pass_2026@localhost:5432/baton_vault
# For local lightweight dev without PostgreSQL:
# DATABASE_URL=sqlite:///./baton.db

REDIS_URL=redis://localhost:6379/0

# --- AI Intelligence Provider ---
# Options: 'hybrid', 'gemini', 'openai'
AI_PROVIDER=hybrid
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- File Storage & Artifacts ---
UPLOAD_DIR=./baton_storage/uploads
S3_BUCKET_NAME=baton-vault-storage
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Client Application ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
