{
  "manifest_version": 3,
  "name": "BATON Knowledge Capture",
  "version": "1.0.0",
  "description": "Capture operational documentation, decisions, and system runbooks into your BATON institutional continuity vault.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "BATON Knowledge Capture"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
